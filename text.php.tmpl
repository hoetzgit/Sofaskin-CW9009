// Gets file name from url
if(empty(\$_REQUEST["report"])) { 
     // if empty then grab the latest years report
     \$year = date("Y");
     \$report = "NOAA/NOAA-".\$year.".txt";
  } else {  
     // Modernized: Ensure only files from the NOAA directory can be accessed
     \$report_input = filter_var(\$_REQUEST["report"], FILTER_SANITIZE_URL);
     \$report = "NOAA/" . basename(\$report_input); 
}

// Get labels for meta and page titles
\$labels = preg_split("/[-.]/", \$report);
\$count = count(\$labels);

if (\$count == 3){
    \$title = \$labels[1];
}

